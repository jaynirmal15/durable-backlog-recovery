node_modules/
bin/
*.jsonl
*.jsonl.*
.DS_Store
*.test
__pycache__/

# Terraform: provider binaries are hundreds of MB and are re-fetched by init.
# The lock file IS committed -- it pins provider versions for reproducibility.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log
overhead_run

# build/access/ is generated. article.tex is tracked because it is the
# submission source and has to travel to the machine that compiles it; every
# other file there is a byte copy of something already tracked under
# build/template/ or figures/, and the PDF is a build product.
build/access/*
!build/access/article.tex
!build/access/supplement-S1.tex
